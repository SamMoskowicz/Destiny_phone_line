STREAMER_NAME=Destiny
PORT=3000

# Set this to auto-detect live status and auto-archive VODs (via a headless
# browser - see README). Leave unset to manage everything manually via the
# /admin/stream/live, /admin/stream/stop, and /admin/stream/recording endpoints.
KICK_CHANNEL=destiny
KICK_POLL_INTERVAL_MS=90000
# Archiving checks happen at a random point between these two (default 15-30
# min) rather than a fixed interval, to avoid a perfectly predictable cadence.
KICK_VIDEOS_POLL_INTERVAL_MS=900000
KICK_VIDEOS_POLL_MAX_INTERVAL_MS=1800000

# Required to protect the /admin/stream/* endpoints. Leave unset only for local testing.
ADMIN_TOKEN=

# Optional: base URL used to build the /live.mp3 link callers hear. Render sets
# RENDER_EXTERNAL_URL automatically, so this is normally only needed for local
# dev or non-Render hosts.
PUBLIC_BASE_URL=

# Required for AI text/voice chat. Keep these server-side and never put them in
# TwiML, a browser bundle, or a WebSocket URL.
OPENAI_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Random secret with at least 32 characters; keep it stable after deployment.
AI_SAFETY_SALT=
# Stores HMAC-based STOP/START opt-out state. Put this on durable storage in
# production if the filesystem is ephemeral.
AI_CONSENT_FILE=data/ai-consent.json

# Optional encrypted, cross-channel memory shared by SMS and AI voice. A
# separate encryption key of at least 32 characters is required when enabled.
# The newest exchanges remain verbatim; older exchanges wait in a bounded
# encrypted overflow until they can be folded into a compact summary. Memory
# has no automatic time-based expiration.
AI_MEMORY_ENABLED=false
AI_MEMORY_FILE=data/ai-memory.enc.json
AI_MEMORY_ENCRYPTION_KEY=
AI_MEMORY_RECENT_EXCHANGES=10
AI_MEMORY_MAX_PENDING_SUMMARY=10
AI_MEMORY_MAX_USERS=10000
AI_MEMORY_MAX_FIELD_CHARACTERS=16000
AI_MEMORY_MAX_CONTEXT_CHARACTERS=32000

# Current quality/latency defaults: the full Realtime model handles normal voice
# turns, while GPT-5.6 Sol in Fast mode handles SMS and difficult voice questions.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_REASONING=low
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_VAD=server_vad
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_TEXT_MODEL=gpt-5.6-sol
OPENAI_TEXT_REASONING=low
OPENAI_DEEP_VOICE_MODEL=gpt-5.6-sol
OPENAI_DEEP_VOICE_REASONING=low
OPENAI_FAST_MODE=true
# Hosted web search is offered to the model automatically for explicit lookups
# and current, changing, niche, or uncertain information. Set false to disable it.
OPENAI_WEB_SEARCH_ENABLED=true
# Search can take longer than an answer from model knowledge alone.
OPENAI_TEXT_TIMEOUT_MS=12000
OPENAI_DEEP_VOICE_TIMEOUT_MS=30000
# A locally synthesized two-pulse cue indicates that a voice web search actually started.
# It starts only when the lookup outlasts the delay, then repeats after a quiet gap.
AI_VOICE_SEARCH_CUE_ENABLED=true
AI_VOICE_SEARCH_CUE_DELAY_MS=650
AI_VOICE_SEARCH_CUE_GAP_MS=1500

# Conservative spend/abuse limits. In-memory limits assume one running instance;
# use a shared store before horizontally scaling the service.
AI_VOICE_MAX_SESSIONS=5
AI_VOICE_MAX_TURNS=30
AI_VOICE_MAX_DEEP_CALLS=10
AI_VOICE_MAX_TOKENS=50000
AI_VOICE_MAX_IDLE_PROMPTS=2
AI_VOICE_STARTS_PER_10_MINUTES=3
AI_VOICE_STARTS_PER_DAY=10
AI_SMS_PER_MINUTE=3
AI_SMS_PER_DAY=20
AI_SMS_GLOBAL_PER_HOUR=500
AI_SMS_GLOBAL_PER_DAY=5000
AI_SMS_MAX_CONCURRENT=10
AI_SMS_MAX_CHARACTERS=600
AI_SMS_OUTBOUND_SEGMENTS_PER_HOUR=1500
AI_SMS_OUTBOUND_SEGMENTS_PER_DAY=10000

# Optional: manually pin the HLS source ffmpeg relays at startup, instead of
# relying on KICK_CHANNEL or the admin API.
LIVE_HLS_URL=
